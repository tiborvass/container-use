# syntax = docker/dockerfile:1.7-labs

ARG CLAUDE_CODE_VERSION=1.0.61

FROM golang AS proxy-builder
WORKDIR /w
RUN --mount=target=. --mount=type=cache,target=/root/.cache/go-build --mount=type=cache,target=/go/pkg/mod <<-EOF
    CGO_ENABLED=0 go build -o /container-use-proxy ./cmd/container-use-proxy
EOF

FROM node:24.1.0-slim@sha256:5ae787590295f944e7dc200bf54861bac09bf21b5fdb4c9b97aee7781b6d95a2
RUN apt-get update && apt-get install -y ca-certificates procps && rm -rf /var/lib/apt/lists/* /tmp/*
RUN --mount=type=cache,target=/root/.npm --mount=src=environment/resources/inject.js,target=/inject.js --mount=src=environment/resources/globals.js,target=/globals.js <<-EOF
    npm install -g @anthropic-ai/claude-code@${CLAUDE_CODE_VERSION} acorn-loose && rm -rf /tmp/* &&
    f=/usr/local/lib/node_modules/@anthropic-ai/claude-code/cli.js &&
    NODE_PATH=$(npm root -g) node /globals.js "$f" >> "$f" &&
    sed -E -i'' 's/(\|\|process\.env\.API_TIMEOUT_MS\|\|process\.env\.MAX_THINKING_TOKENS)\|\|process\.env\.ANTHROPIC_BASE_URL/\1/' "$f" &&
    x=$(grep -m1 -Eo ',\{([^:]+:[^,\}]+,)+initialPrompt: *[^,"]+,' "$f" | head -1 | sed -E 's/.*,initialPrompt:([^,]+),$/\1/') && sed -Ei'' 's/("No conversation found to continue".*default\.createElement\(.*\binitialPrompt: *)"",/\1'"$x"',/' "$f" &&
    cat /inject.js >> "$f"
EOF


FROM node:24.1.0-slim@sha256:5ae787590295f944e7dc200bf54861bac09bf21b5fdb4c9b97aee7781b6d95a2 AS claude-code
RUN apt-get update && apt-get install -y ca-certificates && rm -rf /var/lib/apt/lists/* /tmp/*
RUN --mount=type=cache,target=/root/.npm <<-EOF
    npm install -g @anthropic-ai/claude-code@${CLAUDE_CODE_VERSION} && rm -rf /tmp/* &&
    f=/usr/local/lib/node_modules/@anthropic-ai/claude-code/cli.js &&
    sed -E -i'' 's/(\|\|process\.env\.API_TIMEOUT_MS\|\|process\.env\.MAX_THINKING_TOKENS)\|\|process\.env\.ANTHROPIC_BASE_URL/\1/' "$f" &&
    x=$(grep -m1 -Eo ',\{([^:]+:[^,\}]+,)+initialPrompt: *[^,"]+,' "$f" | head -1 | sed -E 's/.*,initialPrompt:([^,]+),$/\1/') &&
    sed -Ei'' 's/("No conversation found to continue".*default\.createElement\(.*\binitialPrompt: *)"",/\1'"$x"',/' "$f"
EOF

RUN useradd -ms /bin/bash cosmos
USER cosmos
#COPY --chown=cosmos:cosmos container-use-proxy-linux /usr/local/bin/container-use-proxy
COPY --from=proxy-builder --chown=cosmos:cosmos /container-use-proxy /usr/local/bin/container-use-proxy
# Create .claude directory for Claude's config
RUN mkdir ~/.claude
# Set proxy environment variable so manual Claude invocations also use the proxy
ENV ANTHROPIC_BASE_URL=http://localhost:8080
EXPOSE 8042
ENTRYPOINT ["/usr/local/bin/container-use-proxy"]


# Image to be inserted in a base image
FROM scratch AS layer
COPY --from=proxy-builder --link /container-use-proxy /usr/local/bin/container-use-proxy
# trick to copy claude symlink
COPY --from=claude-code --link --exclude=!claude /usr/local/bin /usr/local/bin
COPY --from=claude-code --link /usr/local/bin/node /usr/local/bin/npm /usr/local/bin/npx /usr/local/bin/
COPY --from=claude-code --link /usr/local/include/node /usr/local/include/node
COPY --from=claude-code --link /usr/local/lib/node_modules /usr/local/lib/node_modules
#COPY --from=cosmos --link /etc/ssl /etc/ssl
#COPY --from=cosmos --link /usr/share/ca-certificates /usr/share/ca-certificates
#COPY --from=cosmos --link /etc/ca-certificates.conf /etc/ca-certificates.conf
#COPY --from=cosmos --link /usr/lib/ssl /usr/lib/ssl
#COPY --from=cosmos --link /usr/sbin/update-ca-certificates /usr/sbin/
#COPY --from=cosmos --link /usr/lib/aarch64-linux-gnu/engines-3 /usr/lib/aarch64-linux-gnu/libcrypto.so.3 /usr/lib/aarch64-linux-gnu/libssl.so.3 /usr/lib/aarch64-linux-gnu/ossl-modules /usr/lib/aarch64-linux-gnu/

FROM debian
RUN useradd -ms /bin/bash cosmos
USER cosmos
# Create .claude directory for Claude's config
RUN mkdir ~/.claude
# Set proxy environment variable so manual Claude invocations also use the proxy
ENV ANTHROPIC_BASE_URL=http://localhost:8080
# No ports exposed - proxy connects to host manager
ENTRYPOINT ["/usr/local/bin/container-use-proxy"]
COPY --link --from=tiborvass/claude-code:layer / /
